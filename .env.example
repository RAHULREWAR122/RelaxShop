# Template only: copy to .env.local (git-ignored) and put the real values there.

# MongoDB connection string. Keep the database name (/ECommerce) in the path.
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/ECommerce?retryWrites=true&w=majority

# Secret used to sign login tokens (any long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Lets accounts created before the password upgrade still sign in.
# Must match the value production has always used.
ENCRYPTION_KEY=

# Admin sign-in (use these on the normal sign-in page)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
